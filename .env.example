# =============================================================================
# Athena Assistant — Environment Variables
# Copy this file to .env and fill in the values you need for your milestone.
# Variables marked with a milestone number are not required until that stage.
# =============================================================================

# -----------------------------------------------------------------------------
# Core — Required from Milestone 1
# -----------------------------------------------------------------------------

# Application environment. Use "development" locally, "production" in deploys.
APP_ENV=development

# Log verbosity. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Which assistant profile to load from the profiles/ directory.
# The value must match a subdirectory name under profiles/.
ACTIVE_PROFILE=athena

# -----------------------------------------------------------------------------
# AI Providers — Required from Milestone 2
# Add API keys for any providers you want to enable.
# Provider routing is configured in config/providers.yaml.
# -----------------------------------------------------------------------------

# OpenAI API key — used by the chatgpt adapter (type: api)
# OPENAI_API_KEY=

# Anthropic API key — used by the claude adapter if switched to api type
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Grok transport (Milestone 21)
# Grok is ONE provider with two transports: "cli" (default) or "api". Choose via
# config/providers.yaml (providers.adapters.grok.transport) or the GROK_TRANSPORT
# override below. Default is cli, so the API is opt-in and never silently
# replaces the Grok CLI.
# -----------------------------------------------------------------------------

# GROK_TRANSPORT=cli                  # cli (default) | api — overrides providers.yaml

# Grok API (xAI) — used only when the api transport is selected.
# Grok's API is OpenAI-compatible (base URL https://api.x.ai/v1).
# XAI_API_KEY=
# GROK_MODEL=grok-4.3                 # optional; default grok-4.3
# GROK_API_URL=https://api.x.ai/v1    # optional; default shown
# GROK_TIMEOUT=120                    # optional; API completion timeout (seconds)

# -----------------------------------------------------------------------------
# Hermes CLI (Milestone 23)
# Opt-in CLI-backed provider (hermes chat -q). Install Hermes, set enabled: true
# on the hermes adapter in config/providers.yaml, and add it to a ranking or use
# preferred_provider: hermes to route to it. Default is disabled and unranked.
# -----------------------------------------------------------------------------

# HERMES_BIN=hermes              # optional; binary name or path (default "hermes")
# HERMES_TIMEOUT=120             # optional; one-shot timeout in seconds (default 120)

# -----------------------------------------------------------------------------
# Local Model — Ollama (Milestone 15.5)
# Opt-in. Enable the "ollama" adapter in config/providers.yaml (enabled: true),
# then set the endpoint and the single active model below. Switch models by
# changing OLLAMA_MODEL — one active model per running configuration.
# -----------------------------------------------------------------------------

# Ollama endpoint (OpenAI-compatible API). Default is local, but it may point at
# another machine, e.g. http://192.168.1.20:11434/v1
# OLLAMA_API_URL=http://localhost:11434/v1

# Active local model name. REQUIRED for the ollama provider to be available.
# Examples: gemma4, qwen3.6  (use a model you have pulled — see `ollama list`)
# OLLAMA_MODEL=gemma4

# Optional: completion timeout in seconds (default 120).
# OLLAMA_TIMEOUT=120

# Optional: Ollama ignores auth — this is only a dummy placeholder the OpenAI
# SDK requires, and is filled in automatically. Leave unset in normal use.
# OLLAMA_API_KEY=

# -----------------------------------------------------------------------------
# Search Providers — Milestone 4
# Configure which search providers are active in config/search.yaml.
# -----------------------------------------------------------------------------

# Perplexity API key — enables the perplexity search provider
# Set enabled: true for the perplexity provider in config/search.yaml
# PERPLEXITY_API_KEY=

# Kagi API key — enables the kagi search provider
# Set enabled: true for the kagi provider in config/search.yaml
# KAGI_API_KEY=

# -----------------------------------------------------------------------------
# Mailbox Integration (DAV/IMAP) — Milestone 7
# -----------------------------------------------------------------------------

# Base URL for your mailbox CardDAV/CalDAV server (e.g. https://mail.example.com/dav/)
# MAILBOX_DAV_URL=

# Username for mailbox DAV authentication
# MAILBOX_USERNAME=

# Password for mailbox DAV authentication
# MAILBOX_PASSWORD=

# -----------------------------------------------------------------------------
# Nextcloud / File DAV Integration — Milestone 9
# -----------------------------------------------------------------------------

# Base URL for your Nextcloud WebDAV endpoint
# Example: https://cloud.example.com/remote.php/dav/files/username/
# NEXTCLOUD_DAV_URL=

# Nextcloud username
# NEXTCLOUD_USERNAME=

# Nextcloud password or app password
# NEXTCLOUD_PASSWORD=

# -----------------------------------------------------------------------------
# Voice — Milestone 5 (browser fallback active; local upgrade path documented)
# -----------------------------------------------------------------------------

# Whisper model size for local STT via faster-whisper (Milestone 5 local upgrade)
# Options: tiny, base, small, medium, large
# Default "base" runs on CPU including Raspberry Pi.
# WHISPER_MODEL_SIZE=base

# Piper voice model for local TTS (Milestone 5 local upgrade)
# See https://github.com/rhasspy/piper for available voices.
# PIPER_VOICE=en_US-lessac-medium

# CalDAV (Mailbox.org or any CalDAV server)
# CALDAV_URL=https://dav.mailbox.org
# CALDAV_USERNAME=you@mailbox.org
# CALDAV_PASSWORD=your_app_password

# CardDAV (Mailbox.org or any CardDAV server — can reuse CalDAV credentials)
# CARDDAV_URL=https://dav.mailbox.org
# CARDDAV_USERNAME=you@mailbox.org
# CARDDAV_PASSWORD=your_app_password

# Nextcloud (self-hosted or cloud)
# NEXTCLOUD_URL=https://cloud.example.com
# NEXTCLOUD_USERNAME=your_username
# NEXTCLOUD_PASSWORD=your_app_password
